# Copié en .env par scripts/preparer.sh

# Port du poste sur lequel l'application est publiée
PORT=8080
# Version de l'application de chaque environnement
VERSION_BLEU=1.0.0
VERSION_VERT=1.1.0
# Mot de passe de la base (TP local uniquement). En cas de changement,
# le reporter aussi dans DB_DSN de config/bleu.env et config/vert.env.
POSTGRES_PASSWORD=optilandes
