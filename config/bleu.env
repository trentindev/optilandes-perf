# Réglages de l'environnement bleu
# Après une modification : docker compose up -d app-bleu (recrée les instances bleues : coupure de service si bleu est actif)

# Nombre de processus de l'application par instance
WORKERS=1
# Nombre maximal de connexions à la base, par processus
DB_POOL_MAX=2
# Délai d'attente d'une connexion libre, en secondes (au-delà : erreur 503)
DB_POOL_TIMEOUT=10
# Durée de vie du cache des créneaux et des tournées, en secondes (0 = pas de cache)
CACHE_TTL=0
# Journalisation de chaque requête (1 = oui, 0 = non)
LOG_REQUETES=1

DB_DSN=postgresql://optilandes:optilandes@db:5432/optilandes
