# Optilandes : reverse proxy
# Caddy reçoit les requêtes sur le port 80 du conteneur
# (publié sur le port PORT du poste, 8080 par défaut).
# Le choix de l'environnement actif, bleu ou vert, se trouve dans actif.caddy.

{
	# Pas de HTTPS automatique : le TP se fait en HTTP sur le poste local.
	auto_https off
}

:80 {
	log {
		output stdout
		format json
	}

	import /etc/caddy/actif.caddy
}
